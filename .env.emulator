# vite --mode emulator 使用的設定（npm run dev:emulator），連到本機 Firestore 模擬器。
# 這裡沒有機密資料；優先順序高於 .env.local。
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-remoteu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-remoteu
VITE_FIREBASE_STORAGE_BUCKET=demo-remoteu.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_EMULATOR=127.0.0.1:8080
